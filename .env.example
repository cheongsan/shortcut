# ---------------------------------------------------------------------------
# Notion
# ---------------------------------------------------------------------------
# Internal integration secret. Starts with `ntn_` (older integrations: `secret_`).
# Create at https://www.notion.so/my-integrations with "Read content" capability.
#
# NOTE: this is NOT the same kind of token as the blog repo's NOTION_ACCESS_TOKEN,
# which is a `token_v2` browser cookie for the unofficial API.
NOTION_TOKEN=

# The shortcut database. You may paste the full Notion URL -- it is normalized
# with the SDK's extractNotionId().
#
# IMPORTANT: creating the integration is not enough. Open the database page and
# use  ...  ->  Connections  ->  <your integration>  to share it. Without that
# step every request fails with `object_not_found`, which reads like "no such
# database" but actually means "not shared".
NOTION_DATABASE_ID=

# Optional. Under Notion API 2025-09-03 you query a *data source*, not a
# database. Left blank, it is resolved once from NOTION_DATABASE_ID and cached.
# Set it in production to remove that cold-start round trip:
#   npm run notion:datasource
NOTION_DATA_SOURCE_ID=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Absolute origin. Used for metadataBase and robots host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Development only
# ---------------------------------------------------------------------------
# Our own SSRF guard blocks loopback and private ranges, which also blocks any
# local fixture server -- so the OG parser is untestable locally without this.
# Ignored unless NODE_ENV !== "production". Never set this in production.
ALLOW_LOCAL_OG_TARGETS=
